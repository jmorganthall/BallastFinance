# Database — the app connects as the restricted role, not the owner.
DATABASE_URL=postgres://ballast_app:changeme@localhost:5432/ballast
# Migrations run as the owner.
DATABASE_MIGRATION_URL=postgres://ballast:changeme@localhost:5432/ballast

# Auth.js / Google OIDC (PRD §2). Never commit real values.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Outbound notifications: the app computes, n8n delivers (PRD §8).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Household defaults
HOUSEHOLD_TIMEZONE=America/Chicago

# --- Docker Compose only ---
POSTGRES_USER=ballast
POSTGRES_PASSWORD=
POSTGRES_DB=ballast
# The restricted role the app connects as. Created by migration 0001.
APP_DB_PASSWORD=
# On Unraid, point at the array: /mnt/user/appdata/ballast/pgdata
DATA_DIR=./pgdata
APP_PORT=3000
# Comma-separated; only these emails can sign in.
SEED_ALLOWED_EMAILS=

# Database — the app connects as the restricted role, not the owner.
DATABASE_URL=postgres://ballast_app:changeme@localhost:5432/ballast
# Migrations run as the owner.
DATABASE_MIGRATION_URL=postgres://ballast:changeme@localhost:5432/ballast

# Auth.js / Google OIDC (PRD §2). Never commit real values.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Outbound notifications: the app computes, n8n delivers (PRD §8).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Household defaults
HOUSEHOLD_TIMEZONE=America/Chicago

# --- Docker Compose only ---
POSTGRES_USER=ballast
POSTGRES_PASSWORD=
POSTGRES_DB=ballast
# The restricted role the app connects as. Created by migration 0001.
APP_DB_PASSWORD=
# On Unraid, point at the array: /mnt/user/appdata/ballast/pgdata
DATA_DIR=./pgdata
APP_PORT=3000
# Comma-separated; only these emails can sign in. Read by the container
# bootstrap on every start, so adding one here and restarting is enough.
SEED_ALLOWED_EMAILS=
SEED_HOUSEHOLD_NAME=Household

# Set to 1 to start the server without migrating or seeding. Only for when you
# are deliberately managing migrations yourself.
SKIP_BOOTSTRAP=

# --- Scheduled jobs (PRD §8). Cron in the household timezone. ---
# Saturday 08:00 — matches the week boundary and the Cap One transfer day.
DIGEST_CRON=0 8 * * 6
DUE_PROMPT_CRON=0 9 * * 6
CHECK_IN_NUDGE_CRON=0 17 * * 0
# Set to 1 to keep the scheduler off (useful locally).
DISABLE_SCHEDULER=
PROMO_WARNING_CRON=0 10 * * 1

# --- Update check ---
# The footer compares the running build with the published image and says when
# a newer one exists. Set to off to skip the check (no outbound network, or a
# fork with its own image). BALLAST_IMAGE_REPO points it at a different image.
BALLAST_UPDATE_CHECK=
BALLAST_IMAGE_REPO=
